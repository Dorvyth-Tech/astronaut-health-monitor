# Copy this file to .env (it is git-ignored) and change the values you need.

# DEMO_MODE=True turns on the demo shortcuts: crew switcher on the profile page,
# one-click demo logins, and the shared demo password.
# Leave it False (the default) for anything that real people can reach.
DEMO_MODE=False

# Pulse Companion layer 2: an AI model that only rephrases the rule-based answers.
# It never changes facts, and any failure falls back to the normal answers.
# OFF by default. Put real keys in .env only (never commit them, never paste them in chat).
COMPANION_LLM_ENABLED=False
# groq (default) or gemini. The other one is used as a fallback if its key is set.
COMPANION_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides:
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite
