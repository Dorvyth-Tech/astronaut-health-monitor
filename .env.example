# Space-Pulse Environment Configuration
# Copy this file to .env (which is ignored by git) and set your custom values.

SECRET_KEY=django-insecure-spacepulse-secret-key-deep-space-mars-2026
DEBUG=True

# DEMO_MODE=True turns on the demo shortcuts: crew switcher on the profile page,
# one-click demo logins, and the shared demo password.
# Leave it False for production / remote deployments.
DEMO_MODE=False

# OpenWeather API Key for live Earth meteorological telemetry
OPENWEATHER_API_KEY=your-openweather-api-key-here
OPENWEATHER_CITY=Cape Canaveral,US

# NASA API Key for real-time space weather (DONKI API)
NASA_API_KEY=your-nasa-api-key-here
